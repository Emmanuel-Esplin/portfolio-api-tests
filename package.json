{
  "name": "portfolio-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API tests for the portfolio site and the GitHub REST API behind it",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:staging": "cross-env ENV=staging npx playwright test",
    "test:strict": "cross-env HEAL_MODE=strict npx playwright test --fail-on-flaky-tests",
    "test:debug": "cross-env HEAL_MODE=off npx playwright test --debug",
    "report": "npx playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "cross-env": "10.1.0",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  }
}
