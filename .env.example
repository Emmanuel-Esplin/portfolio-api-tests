# Copy to .env.local (or .env.staging) and fill in. Real environment variables win.
SITE_BASE_URL=https://emmanuel-esplin.github.io
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_USER=Emmanuel-Esplin
# Optional: fine-grained, read-only public access, 90-day expiry. Leave empty to run at 60 requests an hour.
GITHUB_TOKEN=
# off | report | strict
HEAL_MODE=report
